# GenricMed Frontend Environment Configuration Blueprint
# Copy this file to .env and configure as needed:

# Base URL pointing to the GenricMed backend API (/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# GEMINI_API_KEY: Optional if utilizing client-side Gemini AI features
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
